<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WarpClock.Themes.LoseHour</RootNamespace>
  </PropertyGroup>

  <!-- Host-provided contract/runtime assemblies: compile against them but do not
       copy them next to the plug-in (Private=false) so the drop-in dll binds to
       the host's already-loaded copies at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\WarpClock.Abstractions\WarpClock.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\..\..\..\..\WARP\src\WarpToolkit.WinForms.DirectX\WarpToolkit.WinForms.DirectX.csproj" Private="false" />
  </ItemGroup>

</Project>
