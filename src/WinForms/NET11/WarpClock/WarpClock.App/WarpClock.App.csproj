<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WarpClock.App</RootNamespace>
    <AssemblyName>WarpClock</AssemblyName>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarpClock.Abstractions\WarpClock.Abstractions.csproj" />
    <ProjectReference Include="..\WarpClock.Engine\WarpClock.Engine.csproj" />
    <ProjectReference Include="..\WarpClock.Themes.Builtin\WarpClock.Themes.Builtin.csproj" />
  </ItemGroup>

  <!-- Sample plug-in themes are loaded at runtime from the plugins directory.
       They are referenced only to sequence the build and copy their output into
       plugins\; ReferenceOutputAssembly=false keeps them out of the app's
       compile-time closure so they behave like real drop-in assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\WarpClock.Themes.Nerd\WarpClock.Themes.Nerd.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\WarpClock.Themes.Scatter\WarpClock.Themes.Scatter.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\WarpClock.Themes.SunFlower\WarpClock.Themes.SunFlower.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\WarpClock.Themes.EmberClock\WarpClock.Themes.EmberClock.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyClockPlugins" AfterTargets="Build">
    <ItemGroup>
      <PluginAssembly Include="..\WarpClock.Themes.Nerd\bin\$(Configuration)\$(TargetFramework)\WarpClock.Themes.Nerd.dll" />
      <PluginAssembly Include="..\WarpClock.Themes.Scatter\bin\$(Configuration)\$(TargetFramework)\WarpClock.Themes.Scatter.dll" />
      <PluginAssembly Include="..\WarpClock.Themes.SunFlower\bin\$(Configuration)\$(TargetFramework)\WarpClock.Themes.SunFlower.dll" />
      <PluginAssembly Include="..\WarpClock.Themes.EmberClock\bin\$(Configuration)\$(TargetFramework)\WarpClock.Themes.EmberClock.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginAssembly)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" Condition="Exists('%(PluginAssembly.Identity)')" />
  </Target>

</Project>
